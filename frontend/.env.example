# アプリケーション基本設定
APP_NAME=Laravel Nuxt Template
NODE_ENV=development

# API接続設定
SERVER_API_BASE_URL=http://localhost:8000
BROWSER_API_BASE_URL=http://localhost:8000

# 開発サーバー設定
PORT=3000
HOST=0.0.0.0

# 認証設定
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=laravel_nuxt_session

# Nuxt Auth設定
NUXT_AUTH_SECRET=your-random-secret-string-here
NUXT_AUTH_ORIGIN=http://localhost:3000

# Google OAuth設定
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry設定（エラー監視）
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
